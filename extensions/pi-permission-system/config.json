{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "piInfrastructureReadPaths": [
    "~/.pi/agent/**"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "$HOME/.ssh/*": "deny",
      "*/users/*/.pi/agent/auth.json": "deny",
      "*\\users\\*\\.pi\\agent\\auth.json": "deny"
    },
    "read": "allow",
    "write": {
      "*": "ask",
      "./.trellis/tasks/*": "allow"
    },
    "edit": {
      "*": "ask",
      "./.trellis/tasks/*": "allow"
    },
    "ls": "allow",
    "codegraph_search": "allow",
    "codegraph_explore": "allow",
    "codegraph_node": "allow",
    "codegraph_callers": "allow",
    "codegraph_callees": "allow",
    "codegraph_impact": "allow",
    "codegraph_status": "allow",
    "codegraph_files": "allow",
    "ask_user_question": "allow",
    "resolve-library-id": "allow",
    "query-docs": "allow",
    "trellis_subagent": {
      "*": { "action": "deny", "reason": "Use subagent instead" }
    },
    "codemode": "allow",
    "grep": "allow",
    "find": "allow",
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "pwd": "allow",
      "ls": "allow",
      "dir": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "cat *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "where *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed *": "allow",
      "python ./.trellis/scripts/task.py *": "allow",
      "python ./.trellis/scripts/get_context.py *": "allow",
      "python3 ./.trellis/scripts/task.py *": "allow",
      "python3 ./.trellis/scripts/get_context.py *": "allow",
      "rg *": "allow",
      "git status *": "allow",
      "export TRELLIS_CONTEXT_ID=*": "allow",
      "export TRELLIS_CONTEXT_ID='*'": "allow",
      "export TRELLIS_CONTEXT_ID=\"*\"": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "git diff -- *": "allow",
      "git branch": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git remote -v": "allow",
      "npm": { "action": "deny", "reason": "Use pnpm instead" },
      "npm *": { "action": "deny", "reason": "Use pnpm instead" },
      "npx stylelint *": "allow",
      "npx eslint *": "allow",
      "npx vue-tsc *": "allow",
      "pnpm exec eslint *": "allow",
      "pnpm exec stylelint *": "allow",
      "pnpm lint *": "allow",
      "wc *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "nl *": "allow",
      "diff *": "allow",
      "xxd *": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git branch --all *": "allow",
      "git branch --list *": "allow",
      "git branch --contains *": "allow",
      "git branch -a --list *": "allow",
      "git branch -a --contains *": "allow",
      "git stash list *": "allow",
      "git rev-parse *": "allow",
      "git show-ref *": "allow",
      "git check-ignore *": "allow",
      "git fetch *": "allow",
      "python ./.trellis/scripts/*": "allow",
      "python .trellis/scripts/*": "allow",
      "py ./.trellis/scripts/*": "allow",
      "py .trellis/scripts/*": "allow"
    },
    "powershell": {
      "*": "ask",
      "cd *": "allow",
      "pwd": "allow",
      "ls": "allow",
      "dir": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "cat *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "where *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "python ./.trellis/scripts/task.py *": "allow",
      "python ./.trellis/scripts/get_context.py *": "allow",
      "python3 ./.trellis/scripts/task.py *": "allow",
      "python3 ./.trellis/scripts/get_context.py *": "allow",
      "rg *": "allow",
      "git status *": "allow",
      "export TRELLIS_CONTEXT_ID=*": "allow",
      "export TRELLIS_CONTEXT_ID='*'": "allow",
      "export TRELLIS_CONTEXT_ID=\"*\"": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "git diff -- *": "allow",
      "git branch": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git remote -v": "allow",
      "npm": { "action": "deny", "reason": "Use pnpm instead" },
      "npm *": { "action": "deny", "reason": "Use pnpm instead" },
      "npx stylelint *": "allow",
      "npx eslint *": "allow",
      "npx vue-tsc *": "allow",
      "pnpm exec eslint *": "allow",
      "pnpm exec stylelint *": "allow",
      "pnpm lint *": "allow",
      "wc *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "nl *": "allow",
      "diff *": "allow",
      "xxd *": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git branch --all *": "allow",
      "git branch --list *": "allow",
      "git branch --contains *": "allow",
      "git branch -a --list *": "allow",
      "git branch -a --contains *": "allow",
      "git stash list *": "allow",
      "git rev-parse *": "allow",
      "git show-ref *": "allow",
      "git check-ignore *": "allow",
      "git fetch *": "allow",
      "python ./.trellis/scripts/*": "allow",
      "python .trellis/scripts/*": "allow",
      "py ./.trellis/scripts/*": "allow",
      "py .trellis/scripts/*": "allow"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow",
      "mcp_search_*": "allow",
      "mcp_connect_*": "allow",
      "dbx_dbx_list_connections": "allow",
      "jetbrain-idea_get_file_problems": "allow",
      "codegraph_search": "allow",
      "codegraph_explore": "allow",
      "codegraph_node": "allow",
      "codegraph_callers": "allow",
      "codegraph_callees": "allow",
      "codegraph_impact": "allow",
      "codegraph_status": "allow",
      "codegraph_files": "allow",
      "dbx_list_connections": "allow",
      "jetbrain-idea_get_symbol_info": "allow",
      "jetbrain-idea_get_project_dependencies": "allow"
    },
    "notify_parent": "allow",
    "get_subagent_result": "allow",
    "ask_parent": "allow",
    "steer_subagent": "allow",
    "skill": {
      "resolve-library-id": "allow",
      "query-docs": "allow",
      "context7-docs": "allow",
      "find-docs": "allow",
      "find-skills": "allow",
      "trellis-update-spec": "allow",
      "trellis-check": "allow",
      "trellis-before-dev": "allow",
      "trellis-brainstorm": "allow",
      "trellis-session-insight": "allow",
      "*": "ask",
      "trellis-*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/agent/*": "allow",
      "*/users/*/.pi/agent/*": "allow",
      "*\\users\\*\\.pi\\agent\\*": "allow",
      "*\\node_modules\\@earendil-works\\*": "allow",
      "*/node_modules/@earendil-works/*": "allow"
    }
  }
}
