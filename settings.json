{
  "quietStartup": true,
  "defaultTools": [
    "read",
    "edit",
    "write",
    "grep",
    "find",
    "ls",
    "bash"
  ],
  "packages": [
    "npm:@gotgenes/pi-permission-system",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-image-paste",
    "npm:pi-hashline-edit-pro",
    "npm:@upstash/context7-pi",
    "https://github.com/StarWishsama/pi-wakatime",
    "npm:pi-animations",
    "npm:pi-rtk-optimizer",
    "https://github.com/StarWishsama/pi-norain-extension",
    "https://github.com/buddingnewinsights/pi-diff/",
    "https://github.com/StarWishsama/pi-tps",
    "npm:@99percentpeople/pi-thinking-fold",
    "npm:@juicesharp/rpiv-warp",
    "https://github.com/StarWishsama/pi-turing-usage.git",
    "https://github.com/ayghri/i-have-adhd",
    "npm:@narumitw/pi-herdr",
    "npm:@gotgenes/pi-subagents",
    "npm:pi-web-access",
    "npm:pi-nano-context",
    "npm:deword",
    "npm:@narumitw/pi-codex-compact"
  ],
  "lastChangelogVersion": "1.4.0",
  "theme": "light/dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "enabledModels": [
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "deepseek/deepseek-v4-flash",
    "deepseek/deepseek-v4-pro",
    "antigravity/gemini-3.7-flash",
    "openai-codex/gpt-6-luna"
  ],
  "defaultProjectTrust": "ask",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "tuiMode": "regular",
  "fullscreenCopyOnSelect": false
}